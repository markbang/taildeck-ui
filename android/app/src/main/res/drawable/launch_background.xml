<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the app background with the dot grid at the size and
     place Android 12 draws its splash icon. Must stay in step with splash.dart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item android:width="150dp" android:height="150dp" android:gravity="center">
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
