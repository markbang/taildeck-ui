<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the splash before our window exists. Same background
         and mark as drawable/launch_background; the icon is the launcher
         foreground on its ic_bg disc, as in the adaptive icon. -->
    <style name="LaunchTheme" parent="LaunchTheme.Base">
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_bg</item>
    </style>
</resources>
